{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DimensionFile",
  "description": "Schema for real-world dimension reference data files.",
  "type": "object",
  "required": ["category", "items"],
  "properties": {
    "category": {
      "type": "string",
      "description": "Category identifier, e.g. 'furniture', 'architecture', 'vehicles'."
    },
    "description": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "display_name", "dimensions"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Machine-readable identifier (snake_case)."
          },
          "display_name": {
            "type": "string",
            "description": "Human-readable name."
          },
          "dimensions": {
            "type": "object",
            "description": "Real-world dimensions in meters.",
            "required": ["width", "depth", "height"],
            "properties": {
              "width":  { "type": "number" },
              "depth":  { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "variants": {
            "type": "array",
            "description": "Named size variants.",
            "items": {
              "type": "object",
              "required": ["name", "dimensions"],
              "properties": {
                "name": { "type": "string" },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "width":  { "type": "number" },
                    "depth":  { "type": "number" },
                    "height": { "type": "number" }
                  }
                }
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}

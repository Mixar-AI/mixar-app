#
# Keeps the upstream/ Blender submodule (and its vendored lib/* submodules)
# pinned to the commit the new branch actually records.
#
# `git checkout <branch>` / `git switch` moves HEAD but does NOT move
# submodule working trees. Different branches here pin different Blender
# releases (e.g. 5.0 vs 5.2), so a stale upstream/ silently overlays Mixar's
# sources onto the wrong Blender and `make build` fails (or worse,
# mis-assembles) in confusing ways. lib/* inside upstream is additionally
# configured `update = none` in upstream/.gitmodules, so plain
# `git submodule update --recursive` never touches it either - it needs its
# own explicit checkout.
#
# Installed via `git config core.hooksPath .githooks` (done by
# scripts/unix/init.sh) so this applies repo-wide, not just to one checkout.

set -euo pipefail

prev_head="$1"
new_head="$2"
is_branch_checkout="$3"

# Only a real branch switch (not `git checkout -- <file>`) can move HEAD:upstream.
[[ "$is_branch_checkout" == "1" ]] || exit 0

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

# Nothing to do on a fresh clone before `make init` has run.
git submodule status -- upstream 2>/dev/null | grep -q '^-' && exit 0

expected_upstream="$(git rev-parse "HEAD:upstream" 2>/dev/null || true)"
[[ -n "$expected_upstream" ]] || exit 0
actual_upstream="$(git -C upstream rev-parse HEAD 2>/dev/null || true)"

if [[ "$actual_upstream" != "$expected_upstream" ]]; then
    echo "post-checkout: re-pinning upstream/ to ${expected_upstream:0:12}"
    git -C upstream checkout -f --detach "$expected_upstream"
fi

# Only re-pin lib/* submodules that are already initialized on this machine
# (each platform only checks out its own lib/<platform>).
while read -r line; do
    [[ "$line" == -* ]] && continue
    lib_path="$(awk '{print $2}' <<< "$line")"
    expected_lib="$(git -C upstream rev-parse "HEAD:$lib_path" 2>/dev/null || true)"
    [[ -n "$expected_lib" ]] || continue
    actual_lib="$(git -C "upstream/$lib_path" rev-parse HEAD 2>/dev/null || true)"
    if [[ "$actual_lib" != "$expected_lib" ]]; then
        echo "post-checkout: re-pinning upstream/$lib_path to ${expected_lib:0:12}"
        git -C "upstream/$lib_path" checkout -f "$expected_lib"
    fi
done < <(git -C upstream submodule status -- lib 2>/dev/null)

# build/ and source/ (the overlaid CMake tree) are shared across branches and
# cannot be reused across a Blender major-version change - warn instead of
# letting the next `make build` fail confusingly mid-configure/compile.
prev_version="$(git show "$prev_head:scripts/unix/settings.sh" 2>/dev/null | grep -m1 'BLENDER_VERSION' || true)"
new_version="$(git show "$new_head:scripts/unix/settings.sh" 2>/dev/null | grep -m1 'BLENDER_VERSION' || true)"
if [[ -n "$prev_version" && -n "$new_version" && "$prev_version" != "$new_version" ]]; then
    echo "post-checkout: BLENDER_VERSION pin changed for this branch."
    echo "post-checkout: run 'make clean_build' before 'make build' - build/ and source/ are shared across branches and can't mix Blender versions."
fi

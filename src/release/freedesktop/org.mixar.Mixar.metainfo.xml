<component type="desktop">
    <id>com.mixar.mixar</id>
    <launchable type="desktop-id">mixar.desktop</launchable>
    <name>Mixar</name>
    <summary>Commercial 3D texturing software</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <description>
        <p>
            Mixar is a commercial 3D texturing software. It supports
            the entirety of the 3D pipeline — modeling, rigging, animation,
            simulation, rendering, compositing, motion tracking, and video
            editing.
        </p>
    </description>
    <url type="homepage">https://www.mixar.app</url>
    <url type="bugtracker">https://github.com/Mixar-AI/mixar-desktop-app/issues</url>
    <url type="faq">https://www.mixar.app/support/faq/</url>

<?xml version="1.0" encoding="UTF-8"?>

<?include "cpack_variables.wxi"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
    RequiredVersion="3.6.3303.0">

    <Product Id="$(var.CPACK_WIX_PRODUCT_GUID)"
        Name="$(var.CPACK_PACKAGE_NAME)"
        Language="1033"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)">

        <Package InstallerVersion="301" Compressed="yes"/>

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>
        <Condition Message="This application is only supported on Windows 8.1, Windows Server 2016, or higher.">
            <![CDATA[Installed OR (VersionNT >= 603)]]>
        </Condition>
        <!-- Upgrade in place (#2060): the new version installs over the old
             one, writing only files that differ, and the old product is
             removed afterwards, by then owning only the files the new
             version dropped. Removing it first deleted and re-copied every
             file and raised a second files-in-use check. This relies on
             component GUIDs staying stable across releases (CPack derives
             them from install paths). REINSTALLMODE stays at the default
             omus: versioned files are still always replaced because the
             release job sets every versioned File row to 65535.65535.65535.65535
             before signing (scripts/windows/package.bat runs
             scripts/ci/force-msi-file-overwrite.ps1), and unversioned files
             are replaced when their hash differs. Where an upgrade lands
             (#2079) is MixarInspect's decision: see "Install scope" below. -->

        <MajorUpgrade
            Schedule="afterInstallExecute"
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT"/>

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON">ProductIcon.ico</Property>
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)"/>
        <?endif?>

        <FeatureRef Id="ProductFeature">
            <ComponentRef Id="MixarStaleShortcuts"/>
            <ComponentRef Id="MixarMovedFrom"/>
            <ComponentRef Id="MixarRegisterPending"/>
        </FeatureRef>

        <!-- Earlier versions' "Mixar X.Y" shortcuts (#2060). CPack names the
             Start menu and desktop shortcuts after MAJOR.MINOR but keeps their
             components' GUIDs, so on a minor bump the old product's removal,
             which now runs after the install, leaves its shortcuts behind.
             RemoveFiles (3500) deletes every "Mixar X.Y" shortcut before
             CreateShortcuts (4500), which recreates the current one: the new
             product installs CM_SHORTCUT itself even though the old one
             shares it. This component's GUID is fixed too, and it installs
             with every new product, so the cleanup runs on every upgrade.
             The patterns match only "Mixar <1-2 chars>.<1-2 chars>.lnk", so
             a user's own "Mixar something.lnk" stays. Its key path is an
             HKCU value, as in CPack's shortcut components (ICE38). -->
        <DirectoryRef Id="PROGRAM_MENU_FOLDER">
            <Component Id="MixarStaleShortcuts" Guid="{F208B3DE-1B9D-476A-A539-291D7FBA476F}">
                <RegistryValue Root="HKCU"
                    Key="Software\$(var.CPACK_PACKAGE_VENDOR)\$(var.CPACK_PACKAGE_NAME)"
                    Name="stale_shortcuts_removed" Type="integer" Value="1" KeyPath="yes"/>
                <RemoveFile Id="MixarStaleMenuLnk1" Name="Mixar ?.?.lnk" On="install"/>
                <RemoveFile Id="MixarStaleMenuLnk2" Name="Mixar ?.??.lnk" On="install"/>
                <RemoveFile Id="MixarStaleMenuLnk3" Name="Mixar ??.?.lnk" On="install"/>
                <RemoveFile Id="MixarStaleMenuLnk4" Name="Mixar ??.??.lnk" On="install"/>
                <RemoveFile Id="MixarStaleDesktopLnk1" Directory="DesktopFolder" Name="Mixar ?.?.lnk" On="install"/>
                <RemoveFile Id="MixarStaleDesktopLnk2" Directory="DesktopFolder" Name="Mixar ?.??.lnk" On="install"/>
                <RemoveFile Id="MixarStaleDesktopLnk3" Directory="DesktopFolder" Name="Mixar ??.?.lnk" On="install"/>
                <RemoveFile Id="MixarStaleDesktopLnk4" Directory="DesktopFolder" Name="Mixar ??.??.lnk" On="install"/>
            </Component>
            <!-- The folder Mixar was in, written only by an install that puts
                 it somewhere else (#2079: MixarMarker sets MIXAR_MOVED_FROM);
                 the next upgrade does not install it again, so the old
                 product's removal deletes it. The app reads it at the first
                 start after the move: it repoints taskbar pins, shortcuts and
                 "Open with" entries still aiming at the old launcher, and
                 update.install_result reports moved_from_program_files. -->
            <Component Id="MixarMovedFrom" Guid="{3EA5BC2D-C64B-428C-AA74-DCB357572105}">
                <Condition>MIXAR_MOVED_FROM</Condition>
                <RegistryValue Root="HKCU"
                    Key="Software\$(var.CPACK_PACKAGE_VENDOR)\$(var.CPACK_PACKAGE_NAME)"
                    Name="moved_from" Type="string" Value="[MIXAR_MOVED_FROM]" KeyPath="yes"/>
            </Component>
            <!-- An elevated per-user install does not run the new launcher
                 (RegisterMixarUser): it sits in a folder the user can write,
                 and an administrator's process must never run a file anyone
                 but an administrator could have replaced. The app registers
                 its file type at its first start without elevation instead
                 (file_type_registration.py) and deletes this value. -->
            <Component Id="MixarRegisterPending" Guid="{A4F1BBB1-3A1A-4EF3-9EF9-09397FBD481B}">
                <Condition>Privileged AND NOT ALLUSERS</Condition>
                <RegistryValue Root="HKCU"
                    Key="Software\$(var.CPACK_PACKAGE_VENDOR)\$(var.CPACK_PACKAGE_NAME)"
                    Name="register_pending" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <!-- Pulls in mixar_legacy_upgrades.wxs (generated by
             build_files/cmake/packaging.cmake), whose <Upgrade> rows remove
             installs made when the UpgradeCode was derived from the
             version-stamped install directory. A WiX Fragment is only linked
             when something references it, and this Property is that
             reference. -->
        <PropertyRef Id="MIXAR_LEGACY_UPGRADE_MARKER"/>

        <UIRef Id="$(var.CPACK_WIX_UI_REF)" />

        <?include "properties.wxi"?>
        <UI>
            <!-- Never from the wizard's elevated copy (MIXAR_ELEVATED_CHILD,
                 #2079): its whole UI runs with an administrator's full token,
                 over the shoulder as that administrator's account, so Mixar
                 (or a browser) started from it would run elevated from a
                 folder the user can write, or as the other account. Its exit
                 dialog says to start Mixar from the Start menu instead. -->
            <Publish Dialog="MixarExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="LaunchMixar"
                Order="1">LAUNCHAPP = 1 and NOT Installed and NOT MIXAR_RELAUNCHED and NOT MIXAR_ELEVATED_CHILD</Publish>
            <Publish Dialog="MixarExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="LaunchDiscord"
                Order="2">JOINDISCORD = 1 and NOT Installed and NOT MIXAR_RELAUNCHED and NOT MIXAR_ELEVATED_CHILD</Publish>
            <ProgressText Action="RegisterMixarUser">Registering Mixar</ProgressText>
            <ProgressText Action="RegisterMixarMachine">Registering Mixar</ProgressText>
        </UI>
        <Property Id="LAUNCHAPP" Value="1" />
        <Property Id="JOINDISCORD" Value="1" />
        <!-- No Restart Manager (#2060): its files-in-use check prompted when
             an antivirus held a file. A file still in use is replaced at the
             next reboot (exit 3010), which the in-app updater reports. -->
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

        <!-- Install scope (#2079). packaging.cmake makes this a dual-purpose
             package: by default (ALLUSERS=2, MSIINSTALLPERUSER=1) it installs
             for the current user in %LocalAppData%\Programs\Mixar with no
             administrator prompt; ALLUSERS=1 on the command line installs for
             every user in C:\Program Files\Mixar. The scope always comes from
             the command line: Windows resolves the folders before any action
             runs, so an action that switched ALLUSERS would give a machine
             product in one user's folder. CPack's search that kept the old
             product's folder is off (see packaging.cmake); the folder is
             MixarInspect's decision (installer_ca/mixar_msi_scope.c):
             - this account's Mixar in Program Files moves into the profile
               when the install runs elevated as the signed-in user, no
               AppLocker / Software Restriction rule allows apps by folder and
               no other account uses that copy; otherwise it is updated where
               it is, as every release before #2079 did;
             - Program Files\Mixar installed by another account is updated
               where it is by an elevated install (an administrator approving
               a standard user's update, or Windows 11 Administrator
               Protection's separate account); without elevation this account
               gets its own copy beside it;
             - a per-user folder the user chose stays, and so does a machine
               install's folder, unless INSTALL_ROOT is on the command line.
             INSTALL_ROOT is Secure so that the wizard's or IT's folder
             reaches the execute sequence. -->
        <Property Id="INSTALL_ROOT" Secure="yes"/>
        <!-- InstallLocation in the Uninstall key, read by the in-app updater. -->
        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALL_ROOT]" After="CostFinalize"/>

        <!-- Program Files as the wizard's folder check and the messages name
             it, read from the registry: in a per-user install Windows
             redirects ProgramFiles64Folder into the user's profile. -->
        <Property Id="MIXAR_PROGRAM_FILES">
            <RegistrySearch Id="MixarProgramFilesPath" Root="HKLM"
                Key="SOFTWARE\Microsoft\Windows\CurrentVersion"
                Name="ProgramW6432Dir" Type="raw" Win64="yes"/>
        </Property>
        <!-- The wizard's folder check: also administrator-only. -->
        <Property Id="MIXAR_PROGRAM_FILES_X86">
            <RegistrySearch Id="MixarProgramFilesX86Path" Root="HKLM"
                Key="SOFTWARE\Microsoft\Windows\CurrentVersion"
                Name="ProgramFilesDir (x86)" Type="raw" Win64="yes"/>
        </Property>
        <!-- Only for an install whose MixarInspect could not run: the old
             product's folder, as CPack's search found it before #2079. -->
        <Property Id="MIXAR_ARP_LOCATION">
            <RegistrySearch Id="MixarArpInstallLocation" Root="HKLM"
                Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[WIX_UPGRADE_DETECTED]"
                Name="InstallLocation" Type="raw" Win64="yes"/>
        </Property>

        <!-- What MixarInspect decides in the wizard reaches the execute
             sequence, which then skips it: the folder the user chose stands. -->
        <Property Id="MIXAR_INSPECTED" Secure="yes"/>
        <Property Id="MIXAR_SCOPE_ACTION" Secure="yes"/>
        <Property Id="MIXAR_SCOPE_REASON" Secure="yes"/>
        <Property Id="MIXAR_SCOPE_REFUSAL" Secure="yes"/>
        <Property Id="MIXAR_OLD_LOCATION" Secure="yes"/>
        <Property Id="MIXAR_ELEVATED_CHILD" Secure="yes"/>

        <CustomAction Id="MixarInspect" BinaryKey="MixarMsiCa" DllEntry="MixarInspect"
            Execute="immediate" Return="ignore"/>
        <CustomAction Id="MixarMarker" BinaryKey="MixarMsiCa" DllEntry="MixarMarker"
            Execute="immediate" Return="ignore"/>
        <CustomAction Id="MixarRelaunchElevated" BinaryKey="MixarMsiCa"
            DllEntry="MixarRelaunchElevated" Execute="immediate" Return="ignore"/>
        <!-- After a move that left Program Files\Mixar empty: the machine-wide
             .mixar association a release before #2079 registered for it
             (register-allusers). Never while another account's copy is
             still there. As SYSTEM: it edits HKLM. -->
        <CustomAction Id="MixarCleanMachineAssociations" BinaryKey="MixarMsiCa"
            DllEntry="MixarCleanMachineAssociations" Execute="deferred" Impersonate="no"
            Return="ignore"/>
        <SetProperty Id="MixarCleanMachineAssociations" Value="[MIXAR_MOVED_FROM]"
            After="MixarMarker" Sequence="execute"><![CDATA[NOT Installed AND NOT ALLUSERS AND Privileged AND MIXAR_MOVED_FROM]]></SetProperty>
        <!-- Removing a copy that was updated in place (or kept in its own
             folder): the association its release before #2079 registered
             for everyone stays in HKLM, which this package's per-user
             unregister leaves, so it goes with the copy, as the released
             uninstall's unregister-allusers took it. -->
        <CustomAction Id="MixarCleanMachineAssociationsOnRemove" BinaryKey="MixarMsiCa"
            DllEntry="MixarCleanMachineAssociations" Execute="deferred" Impersonate="no"
            Return="ignore"/>
        <SetProperty Id="MixarCleanMachineAssociationsOnRemove" Value="[INSTALL_ROOT]"
            Before="MixarCleanMachineAssociationsOnRemove" Sequence="execute"><![CDATA[(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL") AND NOT ALLUSERS AND Privileged]]></SetProperty>
        <!-- Without MixarInspect (its DLL could not run), the old product's
             folder: an upgrade in place, exactly as before #2079. -->
        <SetProperty Id="INSTALL_ROOT" Action="MixarKeepWithoutInspect" Value="[MIXAR_ARP_LOCATION]"
            After="MixarInspect" Sequence="both"><![CDATA[NOT Installed AND NOT MIXAR_INSPECTED AND NOT INSTALL_ROOT AND MIXAR_ARP_LOCATION]]></SetProperty>

        <InstallUISequence>
            <Custom Action="MixarInspect" After="AppSearch"><![CDATA[NOT Installed AND NOT MIXAR_INSPECTED]]></Custom>
            <!-- The wizard handed the install to an elevated copy of itself
                 (MixarElevateDlg): this one installs nothing. -->
            <ExecuteAction><![CDATA[NOT MIXAR_RELAUNCHED]]></ExecuteAction>
        </InstallUISequence>

        <!-- SCOPE REFUSALS: MixarInspect sets MIXAR_SCOPE_REFUSAL only where
             going ahead would fail at the end or leave a second copy; the
             install then stops at LaunchConditions before any change, with a
             message saying what to do instead. LaunchConditions runs in both
             sequences, so a silent install exits 1603 and its verbose log
             names the reason ("Adding MIXAR_SCOPE_REFUSAL property. Its value
             is '...'"), which the in-app updater reads (msi_refusal).
             - system: SYSTEM (a deployment tool) without ALLUSERS=1 and no
               Mixar of its own; it would install into SYSTEM's profile.
             - machine: Mixar is installed for all users (an IT install with
               ALLUSERS=1) and this is a per-user install. Windows Installer
               finds related products only in the package's own context, so it
               would install a second copy. IT updates with ALLUSERS=1.
             - needs_admin: this account's own Mixar in Program Files, without
               elevation, in a quiet install. Removing it needs an
               administrator, so the upgrade would fail at its very end and
               roll back. The wizard asks for approval instead (relaunch). -->
        <Condition Message="This installer runs as the SYSTEM account and installs Mixar for one account only, so it has made no changes. To install Mixar for every user of this computer from a deployment tool, add ALLUSERS=1 to the msiexec command line.">
            <![CDATA[Installed OR MIXAR_SCOPE_REFUSAL <> "system"]]>
        </Condition>
        <Condition Message="Mixar is installed for all users of this computer, so this installer, which installs Mixar for your account only, has made no changes. To update it, an administrator runs: msiexec /i &quot;[OriginalDatabase]&quot; ALLUSERS=1">
            <![CDATA[Installed OR MIXAR_SCOPE_REFUSAL <> "machine"]]>
        </Condition>
        <Condition Message="Mixar is installed in [MIXAR_OLD_LOCATION]. Moving it to your user folder, after which updates no longer need an administrator, needs administrator approval once, so this installer has made no changes. Double-click the installer and accept the Windows prompt, or click Restart &amp; Update in Mixar.">
            <![CDATA[Installed OR MIXAR_SCOPE_REFUSAL <> "needs_admin"]]>
        </Condition>

        <UIRef Id="WixUI_ErrorProgressText" />
        <CustomAction Id="LaunchMixar"
             FileKey="CM_FP_mixar_launcher.exe"
             ExeCommand=""
             Return="asyncNoWait" />
        <CustomAction Id="LaunchDiscord"
             ExeCommand="explorer.exe &quot;https://discord.com/invite/YVqvkQx8rX&quot;"
             Directory="INSTALL_ROOT"
             Return="asyncNoWait" />
        <!-- File types follow the scope (#2079): a per-user install registers
             .mixar for its user (HKCU, run as that user), a machine install
             for everyone (HKLM, as the installer service). A per-user install
             deletes ALLUSERS, so "NOT ALLUSERS" is the per-user test. -->
        <CustomAction Id="RegisterMixarUser"
                      Impersonate="yes"
                      Execute="deferred"
                      FileKey="CM_FP_mixar_launcher.exe"
                      ExeCommand="--register"
                      Return="ignore" />
        <CustomAction Id="RegisterMixarMachine"
                      Impersonate="no"
                      Execute="deferred"
                      FileKey="CM_FP_mixar_launcher.exe"
                      ExeCommand="--register-allusers"
                      Return="ignore" />
        <CustomAction Id="UnRegisterMixarUser"
                      Impersonate="yes"
                      Execute="deferred"
                      FileKey="CM_FP_mixar_launcher.exe"
                      ExeCommand="--unregister"
                      Return="ignore" />
        <CustomAction Id="UnRegisterMixarMachine"
                      Impersonate="no"
                      Execute="deferred"
                      FileKey="CM_FP_mixar_launcher.exe"
                      ExeCommand="--unregister-allusers"
                      Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="MixarInspect" After="AppSearch"><![CDATA[NOT Installed AND NOT MIXAR_INSPECTED]]></Custom>
            <Custom Action="MixarMarker" Before="CostFinalize"><![CDATA[NOT Installed]]></Custom>
            <Custom Action="MixarCleanMachineAssociations" After="RemoveExistingProducts"><![CDATA[NOT Installed AND NOT ALLUSERS AND Privileged AND MIXAR_MOVED_FROM]]></Custom>
            <!-- Not while this product is being removed: with the old product
                 removed after the new one installs, the launcher is still on
                 disk then, and an upgrade would register a second time. -->
            <Custom Action="RegisterMixarUser" After="InstallFiles">NOT (REMOVE="ALL") AND NOT ALLUSERS AND NOT Privileged</Custom>
            <Custom Action="RegisterMixarMachine" After="RegisterMixarUser">NOT (REMOVE="ALL") AND ALLUSERS</Custom>
            <!-- https://stackoverflow.com/questions/320921/how-to-add-a-wix-custom-action-that-happens-only-on-uninstall-via-msi -->
            <Custom Action="UnRegisterMixarUser" Before="RemoveFiles">(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL") AND NOT ALLUSERS</Custom>
            <Custom Action="UnRegisterMixarMachine" After="UnRegisterMixarUser">(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL") AND ALLUSERS</Custom>
            <Custom Action="MixarCleanMachineAssociationsOnRemove" After="RemoveFiles"><![CDATA[(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL") AND NOT ALLUSERS AND Privileged]]></Custom>
        </InstallExecuteSequence>
    </Product>
</Wix>

#include "stdcycles.h"

/* OSL cannot express the measured AxF CarPaint2 closure (it needs the light
 * direction at evaluation time); SVM evaluates it exactly. This is a neutral
 * stand-in so OSL renders do not fail. */
shader node_axf_carpaint_bsdf(color Color = 1.0,
                              normal Normal = N,
                              point FlakeUV = P,
                              point CoatUV = P,
                              vector Tangent = vector(0.0, 0.0, 0.0),
                              color Tint = 1.0,
                              float FlakeStrength = 1.0,
                              float OrangePeel = 1.0,
                              float CoatReflection = 1.0,
                              float CoatRoughness = 0.0,
                              string TableFilename = "",
                              string FlakesFilename = "",
                              string CoatFilename = "",
                              output closure color BSDF = 0)
{
  BSDF = Color * Tint * 0.5 * diffuse(Normal);
}

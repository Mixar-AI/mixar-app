msgstr "ഇൻപുട്ട് ചിത്രമായി ഉപയോഗിക്കുക"

msgid "Make this view the input image the model is built from. It leaves the multi-view set — the vendor has no angle for a front view — and the previous input image swaps into the set at the angle it freed"
msgstr "മോഡൽ നിർമ്മിക്കുന്ന ഇൻപുട്ട് ചിത്രമായി ഈ വ്യൂവിനെ മാറ്റുക. അത് മൾട്ടി-വ്യൂ സെറ്റ് വിടുന്നു — മുൻവശ വ്യൂവിന് വെൻഡറിന് കോണില്ല — മുമ്പത്തെ ഇൻപുട്ട് ചിത്രം അത് ഒഴിവാക്കിയ കോണിൽ സെറ്റിലേക്ക് മാറുന്നു"

msgid "'{name}' is now the input image; '{name2}' joined the set as {demoted}"
msgstr "'{name}' ഇപ്പോൾ ഇൻപുട്ട് ചിത്രമാണ്; '{name2}' {demoted} ആയി സെറ്റിൽ ചേർന്നു"

msgid "'{name}' is now the input image"
msgstr "'{name}' ഇപ്പോൾ ഇൻപുട്ട് ചിത്രമാണ്"

msgid "Clear Views"
msgstr "വ്യൂകൾ മായ്ക്കുക"

msgid "Empty the multi-view set. The images stay on the moodboard; the tab goes back to generating from its input image alone"
msgstr "മൾട്ടി-വ്യൂ സെറ്റ് ശൂന്യമാക്കുക. ചിത്രങ്ങൾ മൂഡ്ബോർഡിൽ തന്നെ നിൽക്കും; ടാബ് വീണ്ടും ഇൻപുട്ട് ചിത്രത്തിൽ നിന്ന് മാത്രം ജനറേറ്റ് ചെയ്യും"

msgid "No multi-view set to clear"
msgstr "മായ്ക്കാൻ മൾട്ടി-വ്യൂ സെറ്റില്ല"

msgid "Multi-view set not found"
msgstr "മൾട്ടി-വ്യൂ സെറ്റ് കണ്ടെത്തിയില്ല"

msgid "Cleared {cleared} view(s)"
msgstr "{cleared} വ്യൂ മായ്ച്ചു"

msgid "Generate a video from text and selected moodboard references"
msgstr "ടെക്സ്റ്റിൽ നിന്നും തിരഞ്ഞെടുത്ത മൂഡ്ബോർഡ് റഫറൻസുകളിൽ നിന്നും ഒരു വീഡിയോ ജനറേറ്റ് ചെയ്യുക"

msgid "Video Gen tab is unavailable"
msgstr "വീഡിയോ ജെൻ ടാബ് ലഭ്യമല്ല"

msgid "Enter a video prompt"
msgstr "ഒരു വീഡിയോ പ്രോംപ്റ്റ് നൽകുക"

msgid "A selected video was moved or deleted"
msgstr "തിരഞ്ഞെടുത്ത ഒരു വീഡിയോ നീക്കുകയോ ഇല്ലാതാക്കുകയോ ചെയ്തു"

msgid "Could not prepare image references: {error}"
msgstr "ചിത്ര റഫറൻസുകൾ തയ്യാറാക്കാൻ കഴിഞ്ഞില്ല: {error}"

msgid "Failed to start video generation: {error}"
msgstr "വീഡിയോ ജനറേഷൻ ആരംഭിക്കാൻ കഴിഞ്ഞില്ല: {error}"

msgid "A duplicate video generation is already queued"
msgstr "ഒരു തനിപ്പകർപ്പ് വീഡിയോ ജനറേഷൻ ഇതിനകം ക്യൂവിലുണ്ട്"

msgid "Added video generation to queue"
msgstr "വീഡിയോ ജനറേഷൻ ക്യൂവിൽ ചേർത്തു"


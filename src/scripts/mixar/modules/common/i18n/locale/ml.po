msgstr "വിൻഡോ-ആഗോള ഏരിയകൾ (ടോപ്പ്ബാർ, സ്റ്റാറ്റസ്ബാർ). Mixar വിപുലീകരണം — ഓൺബോർഡിങിന് റീഡ്രോയ്ക്കായി ടോപ്പ്ബാർ അഭിസംബോധന ചെയ്യാൻ തുറന്നുവച്ചത്."

msgid "QA UI Dump"
msgstr "QA UI ഡമ്പ്"

msgid "JSON snapshot of all live UI widgets (labels, operators, properties, window-space rects, state) for the Mixar QA harness"
msgstr "Mixar QA ഹാർനെസിനുള്ള എല്ലാ ലൈവ് UI വിജറ്റുകളുടെയും JSON സ്നാപ്ഷോട്ട് (ലേബലുകൾ, ഓപ്പറേറ്ററുകൾ, പ്രോപ്പർട്ടികൾ, വിൻഡോ-സ്പേസ് റെക്റ്റുകൾ, നില)"

msgid "Window Resizing"
msgstr "വിൻഡോ റീസൈസ്"

msgid "Handlers are running from inside an OS window resize. Defer viewport renders (render.opengl) until this is False"
msgstr "ഹാൻഡ്ലറുകൾ ഒരു OS വിൻഡോ റീസൈസിനുള്ളിൽ നിന്ന് പ്രവർത്തിക്കുന്നു. ഇത് False ആകുന്നതുവരെ വ്യൂപോർട്ട് റെൻഡറുകൾ (render.opengl) മാറ്റിവയ്ക്കുക"

msgid "Splash Open"
msgstr ""

msgid "The startup splash popup is on screen; it closes on a button, a click outside it or Escape"
msgstr ""

msgid "Microphone permission is required"
msgstr "മൈക്രോഫോൺ അനുമതി ആവശ്യമാണ്"

msgid "Microphone unavailable. Check input device and privacy settings."
msgstr "മൈക്രോഫോൺ ലഭ്യമല്ല. ഇൻപുട്ട് ഉപകരണവും സ്വകാര്യത ക്രമീകരണങ്ങളും പരിശോധിക്കുക."

msgid "Microphone could not start"
msgstr "മൈക്രോഫോൺ ആരംഭിക്കാനായില്ല"

msgid "Microphone stalled or capture buffer overflowed"
msgstr "മൈക്രോഫോൺ നിന്നുപോയി, അല്ലെങ്കിൽ ക്യാപ്ചർ ബഫർ നിറഞ്ഞു"

msgid "Microphone disconnected"
msgstr "മൈക്രോഫോൺ വിച്ഛേദിച്ചു"

msgid "Mixar File View"
msgstr "Mixar ഫയൽ വ്യൂ"

msgid "Proxies have been removed from Mixar (%d proxies were automatically converted to library overrides, %d proxies could not be converted and were cleared). Consider re-saving any library .mixar file with the newest Mixar version"
msgstr "Mixar-ൽ നിന്ന് പ്രോക്സികൾ നീക്കം ചെയ്തു (%d പ്രോക്സികൾ സ്വയം ലൈബ്രറി ഓവർറൈഡുകളാക്കി, %d പ്രോക്സികൾ പരിവർത്തനം ചെയ്യാനായില്ല, അവ മായ്ച്ചു). ഏതെങ്കിലും ലൈബ്രറി .mixar ഫയൽ ഏറ്റവും പുതിയ Mixar പതിപ്പിൽ വീണ്ടും സംരക്ഷിക്കുക"

msgid "Cannot save mixar file, path \"%s\" is not writable"
msgstr "mixar ഫയൽ സംരക്ഷിക്കാനാകില്ല, പാത \"%s\" എഴുതാനാകില്ല"

msgid "Cannot save mixar file, path \"%s\" is a directory"
msgstr "mixar ഫയൽ സംരക്ഷിക്കാനാകില്ല, പാത \"%s\" ഒരു ഡയറക്ടറിയാണ്"

msgid "Mixar will start next time as it is now."
msgstr "Mixar അടുത്ത തവണ ഇപ്പോഴുള്ളതുപോലെ ആരംഭിക്കും."

msgid "Load Factory Mixar Preferences"
msgstr "ഫാക്ടറി Mixar മുൻഗണനകൾ ലോഡ് ചെയ്യുക"

msgid "Load user interface setup from the .mixar file"
msgstr ".mixar ഫയലിൽ നിന്ന് യൂസർ ഇന്റർഫേസ് സജ്ജീകരണം ലോഡ് ചെയ്യുക"

msgid "Allow .mixar file to execute scripts automatically, default available from system preferences"
msgstr ".mixar ഫയലിന് സ്ക്രിപ്റ്റുകൾ സ്വയം പ്രവർത്തിപ്പിക്കാൻ അനുവദിക്കുക, സ്ഥിരം സിസ്റ്റം മുൻഗണനകളിൽ ലഭ്യമാണ്"

msgid "Open a Mixar file"
msgstr "ഒരു Mixar ഫയൽ തുറക്കുക"

msgid "Load user interface setup in the .mixar file"
msgstr ".mixar ഫയലിലെ യൂസർ ഇന്റർഫേസ് സജ്ജീകരണം ലോഡ് ചെയ്യുക"

msgid "Mixar Files"
msgstr "Mixar ഫയലുകൾ"

msgid "Show only .mixar files"
msgstr ".mixar ഫയലുകൾ മാത്രം കാണിക്കുക"

msgid "Blend Files"
msgstr "Blend ഫയലുകൾ"

msgid "Show only .blend files"
msgstr ".blend ഫയലുകൾ മാത്രം കാണിക്കുക"

msgid "File Extension"
msgstr "ഫയൽ എക്സ്റ്റൻഷൻ"

msgid "File extension filter"
msgstr "ഫയൽ എക്സ്റ്റൻഷൻ ഫിൽറ്റർ"

msgid "Write compressed .mixar file"
msgstr "കംപ്രസ് ചെയ്ത .mixar ഫയൽ എഴുതുക"

msgid "Save as .mixar file"
msgstr ".mixar ഫയലായി സംരക്ഷിക്കുക"

msgid "Save as .blend file"
msgstr ".blend ഫയലായി സംരക്ഷിക്കുക"

msgid "Save the current Mixar file with a numerically incremented name that does not overwrite any existing files"
msgstr "നിലവിലുള്ള ഫയലുകളൊന്നും തിരുത്തിയെഴുതാതെ, സംഖ്യ കൂട്ടിയ പേരിൽ നിലവിലെ Mixar ഫയൽ സംരക്ഷിക്കുക"

msgid "Save Mixar File"
msgstr "Mixar ഫയൽ സംരക്ഷിക്കുക"

msgid "Save the current Mixar file"
msgstr "നിലവിലെ Mixar ഫയൽ സംരക്ഷിക്കുക"

msgid "Exit Mixar after saving"
msgstr "സംരക്ഷിച്ച ശേഷം Mixar-ൽ നിന്ന് പുറത്തുകടക്കുക"

msgid "This file was saved by a newer version of Mixar (%s)."
msgstr "ഈ ഫയൽ പുതിയ Mixar പതിപ്പ് (%s) സംരക്ഷിച്ചതാണ്."

msgid "Saving it with this Mixar (%s) may cause loss of data."
msgstr "ഇത് ഈ Mixar (%s) കൊണ്ട് സംരക്ഷിച്ചാൽ ഡാറ്റ നഷ്ടപ്പെട്ടേക്കാം."

msgid "This file is managed by the Mixar asset system. It can only be"
msgstr "ഈ ഫയൽ Mixar അസറ്റ് സിസ്റ്റം കൈകാര്യം ചെയ്യുന്നു. ഇതിന് മാത്രമേ കഴിയൂ"

msgid "Filter .mixar files"
msgstr ".mixar ഫയലുകൾ ഫിൽറ്റർ ചെയ്യുക"

msgid "Filter backup .mixar files"
msgstr "ബാക്കപ്പ് .mixar ഫയലുകൾ ഫിൽറ്റർ ചെയ്യുക"

msgid "No"
msgstr ""

msgctxt "WindowManager"
msgid "Newer graphics drivers might be available with better Mixar compatibility."
msgstr "മികച്ച Mixar അനുയോജ്യതയുള്ള പുതിയ ഗ്രാഫിക്സ് ഡ്രൈവറുകൾ ലഭ്യമായേക്കാം."

msgctxt "WindowManager"
msgid "Upgrading to the latest macOS version may improve Mixar support"
msgstr "ഏറ്റവും പുതിയ macOS പതിപ്പിലേക്ക് അപ്ഗ്രേഡ് ചെയ്താൽ Mixar പിന്തുണ മെച്ചപ്പെട്ടേക്കാം"

msgctxt "WindowManager"
msgid "Mixar will now close."
msgstr "Mixar ഇപ്പോൾ അടയ്ക്കും."

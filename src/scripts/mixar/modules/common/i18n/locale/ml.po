msgstr "{count} അനോട്ടേഷൻ സ്ട്രോക്ക്"

msgid "Cleared {items}"
msgstr "{items} മായ്ച്ചു"

msgid "Duplicate selected images and text boxes (Shift+D)"
msgstr "തിരഞ്ഞെടുത്ത ചിത്രങ്ങളും ടെക്സ്റ്റ് ബോക്സുകളും പകർപ്പാക്കുക (Shift+D)"

msgid "Duplicated {node_count} node(s) - move to position"
msgstr "{node_count} നോഡ് പകർപ്പാക്കി - സ്ഥാനത്തേക്ക് നീക്കുക"


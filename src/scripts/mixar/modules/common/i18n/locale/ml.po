msgid "Flipped {count} image(s) vertically"
msgstr "{count} ചിത്രം ലംബമായി മറിച്ചു"

msgid "Rotate selected moodboard images 90° clockwise (R)"
msgstr "തിരഞ്ഞെടുത്ത മൂഡ്ബോർഡ് ചിത്രങ്ങൾ 90° ഘടികാരദിശയിൽ തിരിക്കുക (R)"


msgstr "എല്ലാറ്റിന്റെയും തിരഞ്ഞെടുപ്പ് മാറ്റി"

msgid "Select a moodboard image as the Input Image — the multi-view set is only sent with the image it was built for"
msgstr "ഇൻപുട്ട് ചിത്രമായി ഒരു മൂഡ്ബോർഡ് ചിത്രം തിരഞ്ഞെടുക്കുക — മൾട്ടി-വ്യൂ സെറ്റ് അത് നിർമ്മിച്ച ചിത്രത്തോടൊപ്പം മാത്രമേ അയയ്ക്കൂ"

msgid "Add every selected moodboard image to the multi-view set, giving each the next unused camera angle. Adjust any angle afterwards with its dropdown"
msgstr "തിരഞ്ഞെടുത്ത ഓരോ മൂഡ്ബോർഡ് ചിത്രവും മൾട്ടി-വ്യൂ സെറ്റിലേക്ക് ചേർക്കുക, ഓരോന്നിനും അടുത്ത ഉപയോഗിക്കാത്ത ക്യാമറ കോൺ നൽകി. പിന്നീട് ഡ്രോപ്പ്ഡൗൺ ഉപയോഗിച്ച് ഏത് കോണും ക്രമീകരിക്കുക"

msgid "Select moodboard images that are not already views"
msgstr "ഇതിനകം വ്യൂകളല്ലാത്ത മൂഡ്ബോർഡ് ചിത്രങ്ങൾ തിരഞ്ഞെടുക്കുക"

msgid "The set already holds {count} views"
msgstr "സെറ്റിൽ ഇതിനകം {count} വ്യൂ ഉണ്ട്"

msgid "No free camera angles left"
msgstr "സ്വതന്ത്ര ക്യാമറ കോണുകളൊന്നും ബാക്കിയില്ല"

msgid "{skipped} image(s) not added — the set is limited to {limit} views"
msgstr "{skipped} ചിത്രം ചേർത്തില്ല — സെറ്റ് {limit} വ്യൂകളായി പരിമിതമാണ്"

msgid "Added {count} view(s): {items}"
msgstr "{count} വ്യൂ ചേർത്തു: {items}"

msgid "Add View From File"
msgstr "ഫയലിൽ നിന്ന് വ്യൂ ചേർക്കുക"

msgid "Load an image file and add it to the multi-view set as the next unused camera angle. It is sent alongside the input image as one multi-view generation"
msgstr "ഒരു ചിത്ര ഫയൽ ലോഡ് ചെയ്ത് അടുത്ത ഉപയോഗിക്കാത്ത ക്യാമറ കോണായി മൾട്ടി-വ്യൂ സെറ്റിലേക്ക് ചേർക്കുക. ഇത് ഇൻപുട്ട് ചിത്രത്തോടൊപ്പം ഒരു മൾട്ടി-വ്യൂ ജനറേഷനായി അയയ്ക്കുന്നു"


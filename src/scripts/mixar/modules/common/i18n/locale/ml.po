msgstr "വ്യൂ ചിത്രത്തിലേക്കുള്ള പാത"

msgid "Could not add the image to the moodboard"
msgstr "ചിത്രം മൂഡ്ബോർഡിലേക്ക് ചേർക്കാൻ കഴിഞ്ഞില്ല"

msgid "Added '{name}' as the {view_type} view"
msgstr "'{name}' {view_type} വ്യൂവായി ചേർത്തു"

msgid "Drop this image from the multi-view set. It stays on the moodboard, it is just no longer sent as one of the views"
msgstr "ഈ ചിത്രം മൾട്ടി-വ്യൂ സെറ്റിൽ നിന്ന് നീക്കുക. അത് മൂഡ്ബോർഡിൽ തന്നെ നിൽക്കും, വ്യൂകളിൽ ഒന്നായി ഇനി അയയ്ക്കില്ല"

msgid "View image not found"
msgstr "വ്യൂ ചിത്രം കണ്ടെത്തിയില്ല"

msgid "View is not part of this set"
msgstr "വ്യൂ ഈ സെറ്റിന്റെ ഭാഗമല്ല"

msgid "Removed '{name}' from the multi-view set"
msgstr "മൾട്ടി-വ്യൂ സെറ്റിൽ നിന്ന് '{name}' നീക്കം ചെയ്തു"


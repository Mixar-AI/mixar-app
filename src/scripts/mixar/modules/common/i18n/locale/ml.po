msgstr "സ്കെയിൽ ചെയ്യാൻ ഇനങ്ങളൊന്നും തിരഞ്ഞെടുത്തിട്ടില്ല"

msgid "Flip selected moodboard images horizontally"
msgstr "തിരഞ്ഞെടുത്ത മൂഡ്ബോർഡ് ചിത്രങ്ങൾ തിരശ്ചീനമായി മറിക്കുക"

msgid "No images selected"
msgstr "ചിത്രങ്ങളൊന്നും തിരഞ്ഞെടുത്തിട്ടില്ല"


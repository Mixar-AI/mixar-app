msgstr "Микрофонът зацикли или буферът за запис преля"

msgid "Microphone disconnected"
msgstr "Микрофонът е прекъснат"

msgid "Mixar File View"
msgstr "Изглед на файлове Mixar"

msgid "Proxies have been removed from Mixar (%d proxies were automatically converted to library overrides, %d proxies could not be converted and were cleared). Consider re-saving any library .mixar file with the newest Mixar version"
msgstr "Прокситата са премахнати от Mixar (%d проксита бяха автоматично преобразувани в замествания на библиотека, %d проксита не можаха да се преобразуват и бяха изчистени). Обмислете да запазите отново всеки библиотечен файл .mixar с най-новата версия на Mixar"

msgid "Cannot save mixar file, path \"%s\" is not writable"
msgstr "Mixar файлът не може да се запази, пътят „%s“ не е достъпен за запис"

msgid "Cannot save mixar file, path \"%s\" is a directory"
msgstr "Mixar файлът не може да се запази, пътят „%s“ е директория"

msgid "Mixar will start next time as it is now."
msgstr "Следващият път Mixar ще стартира както е сега."

msgid "Load Factory Mixar Preferences"
msgstr "Зареди фабричните предпочитания на Mixar"

msgid "Load user interface setup from the .mixar file"
msgstr "Зареди настройката на потребителския интерфейс от файла .mixar"

msgid "Allow .mixar file to execute scripts automatically, default available from system preferences"
msgstr "Позволи на файла .mixar да изпълнява скриптове автоматично; подразбирането е налично в системните предпочитания"

msgid "Open a Mixar file"
msgstr "Отвори файл на Mixar"

msgid "Load user interface setup in the .mixar file"
msgstr "Зареди настройката на потребителския интерфейс във файла .mixar"

msgid "Mixar Files"
msgstr "Файлове на Mixar"

msgid "Show only .mixar files"
msgstr "Показва само файлове .mixar"

msgid "Blend Files"
msgstr "Файлове Blend"

msgid "Show only .blend files"
msgstr "Показва само файлове .blend"

msgid "File Extension"
msgstr "Разширение на файла"

msgid "File extension filter"
msgstr "Филтър по разширение на файла"

msgid "Write compressed .mixar file"
msgstr "Запиши компресиран файл .mixar"

msgid "Save as .mixar file"
msgstr "Запази като файл .mixar"

msgid "Save as .blend file"
msgstr "Запази като файл .blend"

msgid "Save the current Mixar file with a numerically incremented name that does not overwrite any existing files"
msgstr "Запазва текущия файл на Mixar с числено увеличено име, което не презаписва съществуващи файлове"

msgid "Save Mixar File"
msgstr "Запази файл на Mixar"

msgid "Save the current Mixar file"
msgstr "Запазва текущия файл на Mixar"

msgid "Exit Mixar after saving"
msgstr "Излез от Mixar след запазване"


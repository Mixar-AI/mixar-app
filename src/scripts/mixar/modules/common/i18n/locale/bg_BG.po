msgstr "Този файл е запазен с по-нова версия на Mixar (%s)."

msgid "Saving it with this Mixar (%s) may cause loss of data."
msgstr "Запазването му с този Mixar (%s) може да доведе до загуба на данни."

msgid "This file is managed by the Mixar asset system. It can only be"
msgstr "Този файл се управлява от системата за ресурси на Mixar. Той може само да бъде"

msgid "Filter .mixar files"
msgstr "Филтрирай файлове .mixar"

msgid "Filter backup .mixar files"
msgstr "Филтрирай резервни файлове .mixar"

msgid "No"
msgstr ""

msgctxt "WindowManager"
msgid "Newer graphics drivers might be available with better Mixar compatibility."
msgstr "Може да има по-нови графични драйвери с по-добра съвместимост с Mixar."

msgctxt "WindowManager"
msgid "Upgrading to the latest macOS version may improve Mixar support"
msgstr "Надграждането до най-новата версия на macOS може да подобри поддръжката на Mixar"

msgctxt "WindowManager"
msgid "Mixar will now close."
msgstr "Mixar ще се затвори сега."

msgstr "Файл кеңейтүүсүнүн чыпкасы"

msgid "Write compressed .mixar file"
msgstr "Кысылган .mixar файлын жазуу"

msgid "Save as .mixar file"
msgstr ".mixar файлы катары сактоо"

msgid "Save as .blend file"
msgstr ".blend файлы катары сактоо"

msgid "Save the current Mixar file with a numerically incremented name that does not overwrite any existing files"
msgstr "Учурдагы Mixar файлын бар файлдардын үстүнөн жазбай турган, саны көбөйгөн ат менен сактайт."

msgid "Save Mixar File"
msgstr "Mixar файлын сактоо"

msgid "Save the current Mixar file"
msgstr "Учурдагы Mixar файлын сактайт."

msgid "Exit Mixar after saving"
msgstr "Сактагандан кийин Mixar'дан чыгуу"

msgid "This file was saved by a newer version of Mixar (%s)."
msgstr "Бул файл Mixar'дын жаңыраак версиясы менен сакталган (%s)."

msgid "Saving it with this Mixar (%s) may cause loss of data."
msgstr "Аны бул Mixar (%s) менен сактоо маалымат жоготууга алып келиши мүмкүн."

msgid "This file is managed by the Mixar asset system. It can only be"
msgstr "Бул файлды Mixar ресурс системасы башкарат. Ал гана"

msgid "Filter .mixar files"
msgstr ".mixar файлдарын чыпкалоо"

msgid "Filter backup .mixar files"
msgstr "Камдык .mixar файлдарын чыпкалоо"

msgid "No"
msgstr ""

msgctxt "WindowManager"
msgid "Newer graphics drivers might be available with better Mixar compatibility."
msgstr "Mixar менен жакшыраак шайкеш келген жаңыраак графика драйверлери болушу мүмкүн."

msgctxt "WindowManager"
msgid "Upgrading to the latest macOS version may improve Mixar support"
msgstr "Эң акыркы macOS версиясына жаңыртуу Mixar колдоосун жакшыртышы мүмкүн"

msgctxt "WindowManager"
msgid "Mixar will now close."
msgstr "Mixar азыр жабылат."

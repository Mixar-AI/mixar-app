msgid "Generate the three reference cards first, then compare them with the sheet"
msgstr "Δημιουργήστε πρώτα τις τρεις κάρτες αναφοράς και μετά συγκρίνετέ τις με το φύλλο"

msgid "Image to 3D failed"
msgstr "Η εικόνα σε 3D απέτυχε"

msgid "Failed to compress '{name}': {error}"
msgstr "Αποτυχία συμπίεσης του «{name}»: {error}"

msgid "Scene generation failed"
msgstr "Η παραγωγή σκηνής απέτυχε"

msgid "Skipping '{name}': exported file is {size:.1f}MB (max {limit}MB)"

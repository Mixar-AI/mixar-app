# Mixar Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
MIXAR_ENV=Dev

# Backend API URL for this environment
MIXAR_BACKEND_URL=https://uat.mixar.app

# Frontend URL for this environment (used for SSO login pages)
MIXAR_FRONTEND_URL=https://uat.mixar.app

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIXAR_LOG_LEVEL=DEBUG

MIXAR_BOTANIQ_PATH=/tmp/botaniq/botaniq_starter/blends/models


# Mixar Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
MIXAR_ENV=Prod

# Backend API URL for this environment
MIXAR_BACKEND_URL=https://api.mixar.app

# Frontend URL for this environment (used for SSO login pages)
MIXAR_FRONTEND_URL=https://www.mixar.app

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIXAR_LOG_LEVEL=INFO

# macOS only (optional): stable code-signing identity for local dev builds.
# Stops the Keychain "Mixar wants your confidential information" prompt from
# reappearing after every rebuild — with a stable certificate, one
# "Always Allow" click persists forever.
# One-time setup: ./scripts/unix/setup_dev_codesign.sh
# MIXAR_DEV_SIGN_ID="Mixar Dev"

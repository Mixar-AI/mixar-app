# Mixar Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
MIXAR_ENV=Prod

# Backend API URL for this environment
MIXAR_BACKEND_URL=https://api.mixar.app

# Frontend URL for this environment (used for SSO login pages)
MIXAR_FRONTEND_URL=https://www.mixar.app

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIXAR_LOG_LEVEL=INFO

# Dev-only browserless login used by the isolated GUI QA harness. Leave these
# unset for normal builds. If any DEV_BYPASS_* value is set while MIXAR_ENV is
# not exactly Dev, config generation aborts rather than baking credentials into
# a non-Dev bundle.
# DEV_BYPASS_ENABLED=true
# DEV_BYPASS_USERNAME=developer@example.com
# DEV_BYPASS_PASSWORD=replace-with-a-dev-only-password

# --- Build: NVIDIA GPU rendering (Cycles) -------------------------------
# MIXAR_CUDA=0 builds with no CUDA, no OptiX and no Cycles GPU kernels.
# That is the big one: with it ON, nvcc compiles the whole Cycles kernel once
# per architecture in CYCLES_CUDA_BINARIES_ARCH (ten passes), which dominates a
# clean build. It changes nothing for incremental Mixar-only rebuilds, and the
# resulting app renders Cycles on CPU only — never ship a release built this way.
# MIXAR_CUDA=1

# Keep CUDA/OptiX device support but skip the precompiled kernels (Cycles then
# compiles them at runtime on first GPU render, once per driver/card).
# MIXAR_CUDA_BINARIES=1

# Narrow the precompiled kernels to your own card instead of all ten
# architectures, e.g. sm_89 for a 40-series. Comma- or space-separated.
# Windows only re-runs CMake when MIXAR_CUDA / MIXAR_CUDA_BINARIES change, so
# after editing this one alone delete build/<env>/build.ninja (or Blender.sln)
# to force a reconfigure; object files are kept either way.
# MIXAR_CUDA_ARCH=
